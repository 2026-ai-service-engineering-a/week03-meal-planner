# ── 역할별 모델: env가 곧 조직도 ──────────────────────────────────────
# 계획자와 검증자는 일부러 다른 회사로 교차한다 (self-preference bias 회피).
# LiteLLM 모델 문자열의 접두사(openai/ · anthropic/ · gemini/)가 프로바이더를 정한다.
# 코드 어디에도 모델명이 없다 — 조합 교체는 이 파일 수정 + 재기동이 전부다.

PLANNER_MODEL=openai/gpt-4.1-mini            # 계획자 — 식단 생성
VALIDATOR_MODEL=anthropic/claude-sonnet-4-5  # 검증자 — 다른 회사로 교차

# 검증자 폴백 체인 — 쉼표 구분, 앞에서부터 순서대로 시도.
# 폴백이 검증자에 붙는 이유: 계획자가 죽으면 "식단이 안 나옴"(불편)이지만,
# 검증자가 죽으면 "검증 안 된 식단이 나감"(위험)이다. 신뢰성 투자는 위험한 쪽부터.
VALIDATOR_FALLBACKS=gemini/gemini-2.5-flash,openai/gpt-4.1-mini

# ── 프로바이더 키 (3개 중 2개 이상 권장 — 교차 검증·폴백 시연) ─────────
# OpenAI:    https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
# Gemini:    https://aistudio.google.com/apikey (무료 발급)
# v0.1은 키 없이도 뜬다 (목 응답). 파이프라인을 실제로 돌릴 때만 필요하다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── 로깅 ─────────────────────────────────────────────────────────────
# debug면 모든 LLM 호출의 조립된 프롬프트 전문·모델 원출력·instructor 재시도
# 과정이 로그에 남는다. 관측 가능성도 요구사항이다.
LOG_LEVEL=info
